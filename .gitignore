# This is a monorepo with one microservice per stack under src/<service>,
# each with its own .gitignore (Maven, Go, npm/yarn, Cypress). This root
# file only covers what's shared across the whole repo, not per-stack.

# Root-level Kubernetes manifest is a tracked deliverable used by local.sh
# (kubectl apply -f dist/kubernetes.yaml) -- everything else under dist/ is not.
dist/*
!dist/kubernetes.yaml

# OS files
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# Editors / IDEs
.idea/
.vscode/
*.iml
*.swp
*.swo

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
